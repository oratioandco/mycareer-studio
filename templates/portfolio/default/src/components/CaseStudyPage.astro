---
export interface Props {
  title: string;
  subtitle?: string;
  company?: string;
  role?: string;
  duration?: string;
  team?: string;
  tags?: string[];
}

const { title, subtitle, company, role, duration, team, tags = [] } = Astro.props;
---

<article class="max-w-4xl mx-auto px-6 py-12">
  <header class="mb-12">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
      {company && <span>{company}</span>}
      {duration && <>
        <span>·</span>
        <span>{duration}</span>
      </>}
      {role && <>
        <span>·</span>
        <span>{role}</span>
      </>}
    </div>
    <h1 class="text-4xl font-bold mb-3">{title}</h1>
    {subtitle && <p class="text-xl text-gray-600">{subtitle}</p>}
    {team && <p class="text-sm text-gray-500 mt-2">Team: {team}</p>}
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded">{tag}</span>
        ))}
      </div>
    )}
  </header>

  <div class="prose prose-lg max-w-none">
    <slot />
  </div>

  <footer class="mt-16 pt-8 border-t border-gray-200">
    <a href="/work" class="text-sm text-gray-500 hover:text-accent transition-colors">← Back to all work</a>
  </footer>
</article>
